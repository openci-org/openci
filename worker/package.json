{
  "name": "openci-worker",
  "version": "0.4.1",
  "description": "OpenCI Worker CLI — polls Supabase for build jobs and executes them via act",
  "bin": {
    "openci-worker": "./dist/index.js"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.tsx",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "oxlint src/",
    "lint:fix": "oxlint src/ --fix",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "ink": "^5.1.0",
    "ink-spinner": "^5.0.0",
    "meow": "^13.0.0",
    "react": "^18.3.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "oxlint": "^1.49.0",
    "react-devtools-core": "^7.0.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3"
  }
}
