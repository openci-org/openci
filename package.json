{
  "name": "openci",
  "private": true,
  "workspaces": [
    "actions/flutter-cd",
    "actions/save-secret-file",
    "apps/landing_page",
    "firebase/functions"
  ],
  "scripts": {
    "build": "vp run -r build",
    "check": "vp run -r check",
    "fmt": "vp run -r fmt",
    "fmt:check": "vp run -r fmt:check",
    "test": "vp run --filter ./actions/flutter-cd test && vp run --filter ./actions/save-secret-file test && vp run --filter ./firebase/functions test:unit",
    "test:all": "vp run -r --filter '!landing-page' test"
  },
  "devDependencies": {
    "vite-plus": "^0.1.21"
  },
  "packageManager": "npm@11.14.1",
  "dependencies": {
    "firebase-admin": "^13.10.0"
  }
}
