#!/bin/sh
# Records the first observed checkout timestamp for each branch.
# Install: git config core.hooksPath .openci/hooks

prev_head="$1"
new_head="$2"
is_branch_checkout="$3"

if [ "$is_branch_checkout" != "1" ]; then
  exit 0
fi

branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ -z "$branch" ]; then
  exit 0
fi

if [ "$branch" = "develop" ]; then
  exit 0
fi

openci_dir="$(git rev-parse --show-toplevel 2>/dev/null)/.openci"
if [ ! -d "$openci_dir" ]; then
  exit 0
fi

branch_log_dir="$openci_dir/branch-log"
branch_log_file="$branch_log_dir/$(printf '%s' "$branch" | git hash-object --stdin).json"
if [ -f "$branch_log_file" ]; then
  exit 0
fi

mkdir -p "$branch_log_dir"
escaped_branch=$(printf '%s' "$branch" | sed 's/\\/\\\\/g; s/"/\\"/g')
echo "{\"branch\":\"$escaped_branch\",\"at\":\"$(date -u +%Y-%m-%dT%H:%M:%SZ)\"}" \
  > "$branch_log_file"
