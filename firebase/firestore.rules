rules_version = '2';

service cloud.firestore {
    match /databases/{database}/documents {

        function isAuthenticated() {
            return request.auth != null;
        }

        function isTeamMember(teamId) {
            return isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/teams_v0/$(teamId)).data.members;
        }

        function isTeamMemberAfter(teamId) {
            return isAuthenticated() && request.auth.uid in getAfter(/databases/$(database)/documents/teams_v0/$(teamId)).data.members;
        }

        function isOptionalString(value, maxLength) {
            return value == null || (value is string && value.size() <= maxLength);
        }

        function isValidTeam(data) {
            return data.keys().hasOnly([
                    'id',
                    'name',
                    'members',
                    'installationIds',
                    'runNumber',
                    'aiEnabled',
                    'githubBaseUrl',
                    'githubApiBaseUrl',
                    'createdAt',
                    'updatedAt'
                ])
                && data.keys().hasAll(['id', 'name', 'members', 'installationIds', 'aiEnabled', 'createdAt', 'updatedAt'])
                && data.id is string
                && data.name is string
                && data.name.size() > 0
                && data.name.size() <= 200
                && data.members is list
                && data.members.size() > 0
                && data.members.size() <= 100
                && data.installationIds is list
                && data.installationIds.size() <= 100
                && (!('runNumber' in data) || data.runNumber is int)
                && data.aiEnabled is bool
                && isOptionalString(data.githubBaseUrl, 500)
                && isOptionalString(data.githubApiBaseUrl, 500)
                && data.createdAt is timestamp
                && data.updatedAt is timestamp;
        }

        function hasOnlyUserFields(data) {
            return data.keys().hasOnly([
                'id',
                'email',
                'displayName',
                'photoUrl',
                'selectedTeamId',
                'selectedRepository',
                'selectedBranch',
                'notificationPreference',
                'fcmTokens',
                'udid',
                'deviceProduct',
                'deviceOsVersion',
                'createdAt',
                'updatedAt'
            ]);
        }

        function hasOnlyUserMutableFields() {
            return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                'id',
                'email',
                'displayName',
                'photoUrl',
                'selectedTeamId',
                'selectedRepository',
                'selectedBranch',
                'notificationPreference',
                'fcmTokens',
                'udid',
                'deviceProduct',
                'deviceOsVersion',
                'updatedAt'
            ]);
        }

        function changedUserFields() {
            return request.resource.data.diff(resource.data).affectedKeys();
        }

        function hasValidSelectedTeamIdAfter(data) {
            return !('selectedTeamId' in data)
                || data.selectedTeamId == null
                || (
                    data.selectedTeamId is string
                    && data.selectedTeamId.size() > 0
                    && data.selectedTeamId.size() <= 128
                    && isTeamMemberAfter(data.selectedTeamId)
                );
        }

        function hasValidSelectedTeamId(data) {
            return !('selectedTeamId' in data)
                || data.selectedTeamId == null
                || (
                    data.selectedTeamId is string
                    && data.selectedTeamId.size() > 0
                    && data.selectedTeamId.size() <= 128
                    && isTeamMember(data.selectedTeamId)
                );
        }

        function hasValidUserFieldValues(data) {
            return (!('id' in data) || data.id is string)
                && isOptionalString(data.email, 320)
                && isOptionalString(data.displayName, 200)
                && isOptionalString(data.photoUrl, 2000)
                && isOptionalString(data.selectedRepository, 500)
                && isOptionalString(data.selectedBranch, 500)
                && (!('udid' in data) || isOptionalString(data.udid, 100))
                && (!('deviceProduct' in data) || isOptionalString(data.deviceProduct, 100))
                && (!('deviceOsVersion' in data) || isOptionalString(data.deviceOsVersion, 100))
                && (!('notificationPreference' in data)
                    || data.notificationPreference in ['all', 'successOnly', 'failureOnly', 'none'])
                && (!('fcmTokens' in data)
                    || (data.fcmTokens is list && data.fcmTokens.size() <= 20))
                && (!('createdAt' in data) || data.createdAt is timestamp)
                && data.updatedAt is timestamp;
        }

        function hasValidChangedUserFieldValues(userId) {
            return (!changedUserFields().hasAny(['id'])
                    || request.resource.data.id == userId)
                && (!changedUserFields().hasAny(['email'])
                    || isOptionalString(request.resource.data.email, 320))
                && (!changedUserFields().hasAny(['displayName'])
                    || isOptionalString(request.resource.data.displayName, 200))
                && (!changedUserFields().hasAny(['photoUrl'])
                    || isOptionalString(request.resource.data.photoUrl, 2000))
                && (!changedUserFields().hasAny(['selectedRepository'])
                    || isOptionalString(request.resource.data.selectedRepository, 500))
                && (!changedUserFields().hasAny(['selectedBranch'])
                    || isOptionalString(request.resource.data.selectedBranch, 500))
                && (!changedUserFields().hasAny(['udid'])
                    || isOptionalString(request.resource.data.udid, 100))
                && (!changedUserFields().hasAny(['deviceProduct'])
                    || isOptionalString(request.resource.data.deviceProduct, 100))
                && (!changedUserFields().hasAny(['deviceOsVersion'])
                    || isOptionalString(request.resource.data.deviceOsVersion, 100))
                && (!changedUserFields().hasAny(['notificationPreference'])
                    || request.resource.data.notificationPreference in ['all', 'successOnly', 'failureOnly', 'none'])
                && (!changedUserFields().hasAny(['fcmTokens'])
                    || (request.resource.data.fcmTokens is list && request.resource.data.fcmTokens.size() <= 20))
                && (!changedUserFields().hasAny(['updatedAt'])
                    || request.resource.data.updatedAt is timestamp)
                && (!changedUserFields().hasAny(['selectedTeamId'])
                    || hasValidSelectedTeamId(request.resource.data));
        }

        function isValidUser(data) {
            return hasOnlyUserFields(data)
                && hasValidUserFieldValues(data)
                && hasValidSelectedTeamIdAfter(data);
        }

        function isValidWorkflow(data) {
            return data.keys().hasOnly([
                    'id',
                    'teamId',
                    'name',
                    'workflowConfig',
                    'workflowSteps',
                    'isEditing',
                    'createdAt',
                    'updatedAt'
                ])
                && data.keys().hasAll(['id', 'teamId', 'name', 'workflowConfig', 'workflowSteps', 'isEditing', 'createdAt', 'updatedAt'])
                && data.id is string
                && data.teamId is string
                && data.name is string
                && data.name.size() > 0
                && data.name.size() <= 200
                && data.workflowConfig is map
                && data.workflowSteps is list
                && data.workflowSteps.size() <= 100
                && data.isEditing is bool
                && data.createdAt is timestamp
                && data.updatedAt is timestamp;
        }

        function isValidEnvironmentVariable(data) {
            return data.keys().hasOnly(['id', 'key', 'value', 'teamId', 'autoIncrement', 'createdAt', 'updatedAt'])
                && data.keys().hasAll(['id', 'key', 'value', 'teamId', 'autoIncrement', 'createdAt', 'updatedAt'])
                && data.id is string
                && data.key is string
                && data.key.size() > 0
                && data.key.size() <= 200
                && data.value is string
                && data.value.size() <= 20000
                && data.teamId is string
                && data.autoIncrement is bool
                && data.createdAt is timestamp
                && data.updatedAt is timestamp;
        }

        function isWorkspaceMember(workspaceId) {
            return isAuthenticated()
                && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
        }

        function isWorkspaceMemberAfter(workspaceId) {
            return isAuthenticated()
                && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role is string;
        }

        function ownsWorkspace() {
            return isAuthenticated()
                && resource.data.ownerUid == request.auth.uid;
        }

        function isWorkspaceOwnerCreate() {
            return isAuthenticated()
                && request.resource.data.ownerUid == request.auth.uid
                && request.resource.data.name is string
                && request.resource.data.name.size() > 0
                && request.resource.data.name.size() <= 200;
        }

        function isWorkspaceOwnerAfterCreate(workspaceId) {
            return isAuthenticated()
                && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.ownerUid == request.auth.uid;
        }

        function isValidIssueCounter(data) {
            return data.keys().hasOnly(['issueKeyPrefix', 'lastIssueNumber', 'updatedAt'])
                && data.issueKeyPrefix is string
                && data.issueKeyPrefix.size() > 0
                && data.issueKeyPrefix.size() <= 16
                && data.lastIssueNumber is int
                && data.lastIssueNumber > 0
                && data.updatedAt is timestamp;
        }

        function isValidIssueBoard(data, teamId) {
            return data.keys().hasOnly(['teamId', 'repository', 'updatedAt'])
                && data.teamId == teamId
                && data.repository is string
                && data.repository.size() > 0
                && data.repository.size() <= 200
                && data.updatedAt is timestamp;
        }

        function isValidIssue(data, teamId) {
            return data.keys().hasOnly([
                    'title',
                    'body',
                    'statusId',
                    'rank',
                    'teamId',
                    'repository',
                    'createdBy',
                    'createdAt',
                    'updatedAt'
                ])
                && data.keys().hasAll([
                    'title',
                    'body',
                    'statusId',
                    'rank',
                    'teamId',
                    'repository',
                    'createdBy',
                    'createdAt',
                    'updatedAt'
                ])
                && data.teamId == teamId
                && data.createdBy is string
                && data.createdBy.size() > 0
                && data.createdBy.size() <= 128
                && data.title is string
                && data.title.size() > 0
                && data.title.size() <= 300
                && data.body is string
                && data.body.size() <= 20000
                && data.statusId in ['triage', 'backlog', 'doing', 'review', 'done']
                && data.rank is number
                && data.repository is string
                && data.repository.size() > 0
                && data.repository.size() <= 200
                && data.createdAt is timestamp
                && data.updatedAt is timestamp;
        }

        match /build_jobs_v0/{buildJobId} {
            allow read: if isTeamMember(resource.data.teamId);
            allow create: if isAuthenticated()
                && request.resource.data.id == buildJobId
                && isTeamMember(request.resource.data.teamId)
                && request.resource.data.status in ['QUEUED', 'WAITING'];
            allow delete: if isAuthenticated()
                && isTeamMember(resource.data.teamId)
                && resource.data.status in ['QUEUED', 'WAITING'];
            allow update: if false;

            match /runs/{runId} {
                allow read: if isAuthenticated() 
                    && isTeamMember(get(/databases/$(database)/documents/build_jobs_v0/$(buildJobId)).data.teamId);
                allow write: if false;

                match /logs/{logId} {
                    allow read: if isAuthenticated() 
                        && isTeamMember(get(/databases/$(database)/documents/build_jobs_v0/$(buildJobId)).data.teamId);
                    allow write: if false;
                }
            }
        }

        match /ci_cd_fix_requests_v0/{requestId} {
            allow read: if isTeamMember(resource.data.teamId);
            allow write: if false;
        }

        function isValidUdidRequest(data) {
            return data.keys().hasOnly(['id', 'userId', 'udid', 'deviceProduct', 'deviceOsVersion', 'teamId', 'buildJobId', 'createdAt', 'status'])
                && data.keys().hasAll(['id', 'userId', 'udid', 'teamId', 'buildJobId', 'createdAt', 'status'])
                && data.id is string
                && data.userId is string
                && data.udid is string
                && data.udid.size() > 0
                && data.udid.size() <= 100
                && isOptionalString(data.deviceProduct, 100)
                && isOptionalString(data.deviceOsVersion, 100)
                && data.teamId is string
                && data.buildJobId is string
                && data.createdAt is string
                && data.createdAt.size() <= 50
                && data.status in ['pending', 'approved', 'rejected'];
        }

        match /udid_requests_v0/{requestId} {
            allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isTeamMember(resource.data.teamId));
            allow create: if isAuthenticated()
                && request.resource.data.id == requestId
                && request.resource.data.userId == request.auth.uid
                && isTeamMember(request.resource.data.teamId)
                && isValidUdidRequest(request.resource.data);
            allow update: if isAuthenticated()
                && isTeamMember(resource.data.teamId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
                && request.resource.data.status in ['approved', 'rejected'];
            allow delete: if isAuthenticated()
                && (resource.data.userId == request.auth.uid || isTeamMember(resource.data.teamId));
        }

        match /worker_instances_v0/{workerId} {
            allow read: if isAuthenticated();
            allow write: if false;
        }

        match /workflows_v1/{workflowId} {
            allow create: if isValidWorkflow(request.resource.data)
                && request.resource.data.id == workflowId
                && isTeamMember(request.resource.data.teamId);
            allow read, delete: if isTeamMember(resource.data.teamId);
            allow update: if isTeamMember(resource.data.teamId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'name',
                    'workflowConfig',
                    'workflowSteps',
                    'isEditing',
                    'updatedAt'
                ])
                && request.resource.data.id == resource.data.id
                && request.resource.data.teamId == resource.data.teamId
                && request.resource.data.createdAt == resource.data.createdAt
                && isValidWorkflow(request.resource.data);
        }

        match /secrets_v0/{secretId} {
            allow read: if isTeamMember(resource.data.teamId);
            allow write: if false;
        }

        match /environment_variables_v0/{envVarId} {
            allow create: if isValidEnvironmentVariable(request.resource.data)
                && request.resource.data.id == envVarId
                && isTeamMember(request.resource.data.teamId);
            allow read, delete: if isTeamMember(resource.data.teamId);
            allow update: if isTeamMember(resource.data.teamId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['key', 'value', 'teamId', 'updatedAt'])
                && request.resource.data.id == resource.data.id
                && request.resource.data.teamId == resource.data.teamId
                && request.resource.data.createdAt == resource.data.createdAt
                && isValidEnvironmentVariable(request.resource.data);
        }

        match /workflow_files_v0/{fileId} {
            allow read: if isTeamMember(resource.data.teamId);
            allow update: if isTeamMember(resource.data.teamId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled']);
            allow create, delete: if false;
        }

        match /teams_v0/{teamId} {
            allow create: if isAuthenticated()
                && isValidTeam(request.resource.data)
                && request.resource.data.id == teamId
                && request.resource.data.members.size() == 1
                && request.resource.data.members[0] == request.auth.uid;
            allow get, delete: if isTeamMember(teamId);
            allow list: if isAuthenticated()
                && request.auth.uid in resource.data.members;
            allow update: if isTeamMember(teamId)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                    'name',
                    'aiEnabled',
                    'githubBaseUrl',
                    'githubApiBaseUrl',
                    'installationIds',
                    'updatedAt'
                ])
                && request.resource.data.id == resource.data.id
                && request.resource.data.members == resource.data.members
                && request.resource.data.createdAt == resource.data.createdAt
                && isValidTeam(request.resource.data);

            match /issue_boards_v0/{repoId} {
                allow read: if isTeamMember(teamId);
                allow create, update: if isTeamMember(teamId)
                    && isValidIssueBoard(request.resource.data, teamId);
                allow delete: if false;

                match /issues_v0/{issueId} {
                    allow read: if isTeamMember(teamId);
                    allow create: if isTeamMember(teamId)
                        && request.resource.data.createdBy == request.auth.uid
                        && isValidIssue(request.resource.data, teamId);
                    allow update: if isTeamMember(teamId)
                        && request.resource.data.createdBy == resource.data.createdBy
                        && request.resource.data.createdAt == resource.data.createdAt
                        && request.resource.data.teamId == resource.data.teamId
                        && request.resource.data.repository == resource.data.repository
                        && isValidIssue(request.resource.data, teamId);
                    allow delete: if isTeamMember(teamId);
                }
            }

            match /repositories_v0/{repoId} {
                allow read: if isTeamMember(teamId);
                allow write: if false;
            }
        }

        match /users_v0/{userId} {
            allow read: if isAuthenticated() && userId == request.auth.uid;
            allow create: if isAuthenticated()
                && userId == request.auth.uid
                && request.resource.data.id == userId
                && isValidUser(request.resource.data);
            allow update: if isAuthenticated()
                && userId == request.auth.uid
                && hasOnlyUserMutableFields()
                && hasValidChangedUserFieldValues(userId);
            allow delete: if false;
        }

        match /users/{uid} {
            allow read, create, update: if isAuthenticated() && uid == request.auth.uid;
            allow delete: if false;

            match /private/{document=**} {
                allow read, write: if false;
            }
        }

        match /workspaces/{workspaceId} {
            allow create: if isWorkspaceOwnerCreate();
            allow read: if isWorkspaceMember(workspaceId) || ownsWorkspace();
            allow update: if isWorkspaceMember(workspaceId)
                || ownsWorkspace()
                || (
                    request.resource.data.ownerUid == request.auth.uid
                    && isWorkspaceMemberAfter(workspaceId)
                );
            allow delete: if false;

            match /members/{uid} {
                allow create: if isAuthenticated()
                    && uid == request.auth.uid
                    && request.resource.data.role == 'owner'
                    && isWorkspaceOwnerAfterCreate(workspaceId);
                allow read: if isWorkspaceMember(workspaceId);
                allow update: if isWorkspaceMember(workspaceId) && uid == request.auth.uid;
                allow delete: if false;
            }

            match /statuses/{statusId} {
                allow read, update: if isWorkspaceMember(workspaceId);
                allow create: if isWorkspaceMember(workspaceId) || isWorkspaceMemberAfter(workspaceId);
                allow delete: if false;
            }

            match /counters/{counterId} {
                allow read: if isWorkspaceMember(workspaceId);
                allow create: if counterId == 'issues'
                    && isWorkspaceMember(workspaceId)
                    && isValidIssueCounter(request.resource.data)
                    && request.resource.data.lastIssueNumber == 1;
                allow update: if counterId == 'issues'
                    && isWorkspaceMember(workspaceId)
                    && isValidIssueCounter(request.resource.data)
                    && request.resource.data.lastIssueNumber == resource.data.lastIssueNumber + 1;
                allow delete: if false;
            }

            match /issues/{issueId} {
                allow read, create, update, delete: if isWorkspaceMember(workspaceId);

                match /cursorAgentRuns/{runId} {
                    allow read: if isWorkspaceMember(workspaceId);
                    allow write: if false;
                }
            }

            match /issueEvents/{eventId} {
                allow read: if isWorkspaceMember(workspaceId);
                allow write: if false;
            }

            match /githubConnections/{connectionId} {
                allow read: if isWorkspaceMember(workspaceId);
                allow write: if false;
            }

            match /syncOutbox/{operationId} {
                allow read, create, update: if isWorkspaceMember(workspaceId);
                allow delete: if false;
            }
        }

        match /{document=**} {
            allow read, write: if false;
        }
    }
}
