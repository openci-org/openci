rules_version = '2';

service cloud.firestore {
    match /databases/{database}/documents {

        function isAuthenticated() {
            return request.auth != null;
        }

        function ownsPersonalWorkspace(workspaceId) {
            return isAuthenticated() && workspaceId == request.auth.uid;
        }

        function isWorkspaceMember(workspaceId) {
            return isAuthenticated()
                && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
        }

        function canAccessWorkspace(workspaceId) {
            return ownsPersonalWorkspace(workspaceId) || isWorkspaceMember(workspaceId);
        }

        match /users/{uid} {
            allow read, create, update: if isAuthenticated() && uid == request.auth.uid;
            allow delete: if false;

            match /private/{document=**} {
                allow read, write: if false;
            }
        }

        match /workspaces/{workspaceId} {
            allow create: if ownsPersonalWorkspace(workspaceId)
                && request.resource.data.ownerUid == request.auth.uid;
            allow read, update: if canAccessWorkspace(workspaceId);
            allow delete: if false;

            match /members/{uid} {
                allow create: if ownsPersonalWorkspace(workspaceId)
                    && uid == request.auth.uid
                    && request.resource.data.role == 'owner';
                allow read: if canAccessWorkspace(workspaceId);
                allow update: if ownsPersonalWorkspace(workspaceId) && uid == request.auth.uid;
                allow delete: if false;
            }

            match /statuses/{statusId} {
                allow read, create, update: if canAccessWorkspace(workspaceId);
                allow delete: if false;
            }

            match /issues/{issueId} {
                allow read, create, update, delete: if canAccessWorkspace(workspaceId);
            }

            match /issueEvents/{eventId} {
                allow read: if canAccessWorkspace(workspaceId);
                allow write: if false;
            }

            match /githubConnections/{connectionId} {
                allow read: if canAccessWorkspace(workspaceId);
                allow write: if false;
            }

            match /githubRepos/{repoId} {
                allow read, create, update, delete: if canAccessWorkspace(workspaceId);
            }

            match /syncOutbox/{operationId} {
                allow read, create, update: if canAccessWorkspace(workspaceId);
                allow delete: if false;
            }
        }

        match /{document=**} {
            allow read, write: if false;
        }
    }
}
