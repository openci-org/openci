{
  "folders": [
    {
      "name": "worker_cli",
      "path": "apps/worker_cli"
    },
    {
      "name": "vm_cli",
      "path": "apps/vm_cli"
    },
    {
      "name": "dashboard",
      "path": "apps/dashboard"
    },
    {
      "name": "web",
      "path": "apps/web"
    },
      {
      "name": "root",
      "path": "."
    },
  ],
  "settings": {
    "explorer.autoReveal": false,
    "dart.onlyAnalyzeProjectsWithOpenFiles": true,
    "dart.analysisExcludedFolders": ["apps/web"],
    "npm.packageManager": "pnpm",
    "terminal.integrated.scrollback": 10000,
    "cSpell.words": [
      "bento",
      "bradlc",
      "cirruslabs",
      "cupertino",
      "dbaeumer",
      "esbenp",
      "firestore",
      "grayscale",
      "masahiro",
      "mocktail",
      "monokai",
      "oklch",
      "openci",
      "opennextjs",
      "oxfmt",
      "oxlint",
      "pubspec",
      "riverpod",
      "secretmanager",
      "shellenv",
      "Stylesheet",
      "Subcollection",
      "subcollections",
      "subheadline",
      "supabase",
      "tailwindplus",
      "turbopack",
      "unawaited",
      "uuidv"
    ],
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
      "source.organizeImports": "explicit"
    },
    "editor.formatOnSave": true,
    "[jsonc]": {
      "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[json]": {
      "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[javascript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[typescript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "[yaml]": {
      "editor.defaultFormatter": "oxc.oxc-vscode"
    },
    "files.associations": {
      "*.css": "tailwindcss"
    },
    "files.exclude": {
      "**/*.g.dart": true,
      "**/*.freezed.dart": true
    }
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "dashboard",
        "cwd": "${workspaceFolder:dashboard}",
        "request": "launch",
        "type": "dart",
        "program": "lib/main.dart",
        "args": ["--dart-define-from-file=config.json"]
      },
      {
        "name": "(release) dashboard",
        "cwd": "${workspaceFolder:dashboard}",
        "request": "launch",
        "type": "dart",
        "program": "lib/main.dart",
        "args": ["--release", "--dart-define-from-file=config.json"]
      }
    ]
  },
  "extensions": {
    "recommendations": [
      "dart-code.dart-code",
      "dart-code.flutter",
      "oxc.oxc-vscode",
      "bradlc.vscode-tailwindcss",
      "streetsidesoftware.code-spell-checker"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Flutter: build_runner watch",
        "type": "shell",
        "command": "dart run build_runner watch -d",
        "options": {
          "cwd": "${workspaceFolder:dashboard}"
        },
        "problemMatcher": [],
        "group": "build",
        "isBackground": true
      },
      {
        "label": "Flutter: clean",
        "type": "shell",
        "command": "flutter clean && flutter pub get",
        "options": {
          "cwd": "${workspaceFolder:dashboard}"
        }
      },
      {
        "label": "Flutter: Build .ipa",
        "type": "shell",
        "command": "flutter clean && flutter pub get && flutter build ipa --dart-define-from-file=config.json",
        "options": {
          "cwd": "${workspaceFolder:dashboard}"
        },
        "problemMatcher": []
      },
      {
        "label": "Web: Dev Server",
        "type": "shell",
        "command": "pnpm dev",
        "options": {
          "cwd": "${workspaceFolder:web}"
        },
        "problemMatcher": [],
        "isBackground": true
      },
      {
        "label": "Web: Build",
        "type": "shell",
        "command": "pnpm build",
        "options": {
          "cwd": "${workspaceFolder:web}"
        },
        "problemMatcher": []
      }
    ]
  }
}
