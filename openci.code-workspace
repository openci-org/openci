{
  "folders": [
    {
      "name": "dashboard (Flutter)",
      "path": "frontend/dashboard",
    },
    {
      "name": "openci_worker_cli",
      "path": "cli/openci_worker_cli",
    },
    {
      "name": "openci_vm_cli",
      "path": "cli/openci_vm_cli",
    },
    {
      "name": "firebase-functions",
      "path": "firebase/functions",
    },
    {
      "name": "firebase",
      "path": "firebase",
    },
    {
      "name": "root",
      "path": ".",
    },
    {
      "name": "frontend (Next.js)",
      "path": "frontend",
    },
    {
      "name": "react-native-sample",
      "path": "frontend/react-native-sample",
    },
  ],
  "settings": {
    "npm.packageManager": "pnpm",
    "terminal.integrated.scrollback": 10000,
    "cSpell.words": [
      "bento",
      "bradlc",
      "cirruslabs",
      "cupertino",
      "dbaeumer",
      "esbenp",
      "firestore",
      "grayscale",
      "masahiro",
      "mocktail",
      "monokai",
      "oklch",
      "openci",
      "opennextjs",
      "oxfmt",
      "oxlint",
      "pubspec",
      "riverpod",
      "secretmanager",
      "shellenv",
      "Stylesheet",
      "Subcollection",
      "subcollections",
      "subheadline",
      "tailwindplus",
      "turbopack",
      "unawaited",
      "uuidv",
    ],
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "always",
      "source.fixAll": "always",
      "source.organizeImports": "explicit",
    },
    "editor.formatOnSave": true,
    "[jsonc]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[javascript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[typescript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[yaml]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "files.associations": {
      "*.css": "tailwindcss",
    },
    "files.exclude": {
      "**/*.g.dart": true,
      "**/*.freezed.dart": true,
    },
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "dashboard",
        "cwd": "${workspaceFolder:dashboard (Flutter)}",
        "request": "launch",
        "type": "dart",
        "program": "lib/main.dart",
        "args": ["--dart-define-from-file=.env.local"],
      },
      {
        "name": "(release) dashboard",
        "cwd": "${workspaceFolder:dashboard (Flutter)}",
        "request": "launch",
        "type": "dart",
        "program": "lib/main.dart",
        "args": ["--release", "--dart-define-from-file=.env.local"],
      },
    ],
  },
  "extensions": {
    "recommendations": [
      "dart-code.dart-code",
      "dart-code.flutter",
      "dbaeumer.vscode-eslint",
      "oxc.oxc-vscode",
      "bradlc.vscode-tailwindcss",
      "streetsidesoftware.code-spell-checker",
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      // ── Flutter ──────────────────────────────────────
      {
        "label": "Flutter: build_runner watch",
        "type": "shell",
        "command": "dart run build_runner watch -d",
        "options": {
          "cwd": "${workspaceFolder:dashboard (Flutter)}",
        },
        "problemMatcher": [],
        "group": "build",
        "isBackground": true,
      },
      {
        "label": "Flutter: clean",
        "type": "shell",
        "command": "flutter clean && flutter pub get",
        "options": {
          "cwd": "${workspaceFolder:dashboard (Flutter)}",
        },
      },
      {
        "label": "Flutter: Build .ipa",
        "type": "shell",
        "command": "flutter clean && flutter pub get && flutter build ipa --dart-define-from-file=.env.local",
        "options": {
          "cwd": "${workspaceFolder:dashboard (Flutter)}",
        },
        "problemMatcher": [],
      },
      // ── Firebase ─────────────────────────────────────
      {
        "label": "Firebase: (Dev) Deploy Functions",
        "type": "shell",
        "command": "firebase use default && firebase deploy --only functions",
        "options": {
          "cwd": "${workspaceFolder:firebase-functions}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Firebase: (Dev) Deploy Rules",
        "type": "shell",
        "command": "firebase use default && firebase deploy --only firestore:rules",
        "options": {
          "cwd": "${workspaceFolder:firebase}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Firebase: (Dev) Deploy Indexes",
        "type": "shell",
        "command": "firebase use default && firebase deploy --only firestore:indexes",
        "options": {
          "cwd": "${workspaceFolder:firebase}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Firebase: (Prod) Deploy Functions",
        "type": "shell",
        "command": "firebase use prod && firebase deploy --only functions && firebase use default",
        "options": {
          "cwd": "${workspaceFolder:firebase-functions}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Firebase: (Prod) Deploy Rules",
        "type": "shell",
        "command": "firebase use prod && firebase deploy --only firestore:rules && firebase use default",
        "options": {
          "cwd": "${workspaceFolder:firebase}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Firebase: (Prod) Deploy Indexes",
        "type": "shell",
        "command": "firebase use prod && firebase deploy --only firestore:indexes && firebase use default",
        "options": {
          "cwd": "${workspaceFolder:firebase}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Firebase: Reauth Login",
        "type": "shell",
        "command": "firebase login --reauth",
        "options": {
          "cwd": "${workspaceFolder:firebase-functions}",
        },
        "problemMatcher": [],
      },
      // ── Hosting ──────────────────────────────────────
      {
        "label": "Hosting: (Dev) Deploy Web",
        "type": "shell",
        "command": "flutter build web --release --dart-define-from-file=.env.local && rm -rf ../../firebase/public && cp -r build/web ../../firebase/public && cd ../../firebase && firebase use default && firebase deploy --only hosting",
        "options": {
          "cwd": "${workspaceFolder:dashboard (Flutter)}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Hosting: (Prod) Deploy Web",
        "type": "shell",
        "command": "flutter build web --release --dart-define-from-file=.env.local && rm -rf ../../firebase/public && cp -r build/web ../../firebase/public && cd ../../firebase && firebase use prod && firebase deploy --only hosting && firebase use default",
        "options": {
          "cwd": "${workspaceFolder:dashboard (Flutter)}",
        },
        "problemMatcher": [],
      },
      // ── Worker CLI ───────────────────────────────────
      {
        "label": "Worker CLI: (Dev) Run",
        "type": "shell",
        "command": "dart",
        "args": [
          "run",
          "bin/openci_worker_cli.dart",
          "--project-id",
          "openci-dev-da298",
          "--service-account",
          "firebase_service_account_dev.json",
        ],
        "options": {
          "cwd": "${workspaceFolder:openci_worker_cli}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Worker CLI: (Prod) Run",
        "type": "shell",
        "command": "dart",
        "args": [
          "run",
          "bin/openci_worker_cli.dart",
          "--project-id",
          "openci-b1b91",
          "--service-account",
          "firebase_service_account.json",
        ],
        "options": {
          "cwd": "${workspaceFolder:openci_worker_cli}",
        },
        "problemMatcher": [],
      },
      // ── Publish ──────────────────────────────────────
      {
        "label": "Publish: Worker CLI",
        "type": "shell",
        "command": "dart pub publish",
        "options": {
          "cwd": "${workspaceFolder:openci_worker_cli}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Publish: VM CLI",
        "type": "shell",
        "command": "dart pub publish",
        "options": {
          "cwd": "${workspaceFolder:openci_vm_cli}",
        },
        "problemMatcher": [],
      },
    ],
  },
}
