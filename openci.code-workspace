{
  "folders": [
    {
      "name": "dashboard (Flutter)",
      "path": "frontend/dashboard",
    },
    {
      "name": "openci_worker_cli",
      "path": "cli/openci_worker_cli",
    },
    {
      "name": "firebase-functions",
      "path": "firebase/functions",
    },
    {
      "name": "root",
      "path": ".",
    },
    {
      "name": "frontend (Next.js)",
      "path": "frontend",
    },
  ],
  "settings": {
    "cSpell.words": [
      "bento",
      "bradlc",
      "cupertino",
      "dbaeumer",
      "esbenp",
      "firestore",
      "grayscale",
      "masahiro",
      "mocktail",
      "oklch",
      "openci",
      "opennextjs",
      "oxfmt",
      "oxlint",
      "riverpod",
      "Stylesheet",
      "subheadline",
      "tailwindplus",
      "turbopack",
      "unawaited",
      "uuidv",
    ],
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "always",
      "source.fixAll": "always",
      "source.organizeImports": "explicit",
    },
    "editor.formatOnSave": true,
    "[jsonc]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[javascript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[typescript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "files.associations": {
      "*.css": "tailwindcss",
    },
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "dashboard",
        "cwd": "${workspaceFolder:dashboard (Flutter)}",
        "request": "launch",
        "type": "dart",
        "program": "lib/main.dart",
      },
    ],
  },
  "extensions": {
    "recommendations": [
      "dart-code.dart-code",
      "dart-code.flutter",
      "dbaeumer.vscode-eslint",
      "oxc.oxc-vscode",
      "bradlc.vscode-tailwindcss",
      "streetsidesoftware.code-spell-checker",
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "build_runner watch",
        "type": "shell",
        "command": "dart run build_runner watch -d",
        "options": {
          "cwd": "${workspaceFolder:dashboard (Flutter)}",
        },
        "problemMatcher": [],
        "group": "build",
        "isBackground": true,
      },
      {
        "label": "flutter clean",
        "type": "shell",
        "command": "flutter clean && flutter pub get",
        "options": {
          "cwd": "${workspaceFolder:dashboard (Flutter)}",
        },
      },
      {
        "label": "Deploy Firebase Functions",
        "type": "shell",
        "command": "firebase deploy --only functions",
        "options": {
          "cwd": "${workspaceFolder:firebase-functions}",
        },
        "problemMatcher": [],
      },
    ],
  },
}
