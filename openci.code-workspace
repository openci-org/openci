{
  "folders": [
    {
      "name": "agent",
      "path": "apps/agent",
    },
    {
      "name": "orchestrator",
      "path": "apps/orchestrator",
    },
    {
      "name": "worker_cli",
      "path": "apps/worker_cli",
    },
    {
      "name": "vm_cli",
      "path": "apps/vm_cli",
    },
    {
      "name": "mobile",
      "path": "apps/mobile",
    },
    {
      "name": "web",
      "path": "apps/web",
    },
    {
      "name": "dart_avf",
      "path": "packages/dart_avf",
    },
    {
      "name": "dart_avf",
      "path": "packages/dart_avf",
    },
  ],
  "settings": {
    "dart.onlyAnalyzeProjectsWithOpenFiles": true,
    "dart.analysisExcludedFolders": ["apps/web"],
    "npm.packageManager": "pnpm",
    "terminal.integrated.scrollback": 10000,
    "cSpell.words": [
      "bento",
      "bradlc",
      "cirruslabs",
      "cupertino",
      "dbaeumer",
      "esbenp",
      "firestore",
      "grayscale",
      "masahiro",
      "mocktail",
      "monokai",
      "oklch",
      "openci",
      "opennextjs",
      "oxfmt",
      "oxlint",
      "pubspec",
      "riverpod",
      "secretmanager",
      "shellenv",
      "Stylesheet",
      "Subcollection",
      "subcollections",
      "subheadline",
      "supabase",
      "tailwindplus",
      "turbopack",
      "unawaited",
      "uuidv",
    ],
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
      "source.organizeImports": "explicit",
    },
    "editor.formatOnSave": true,
    "[jsonc]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[javascript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[typescript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[yaml]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "files.associations": {
      "*.css": "tailwindcss",
    },
    "files.exclude": {
      "**/*.g.dart": true,
      "**/*.freezed.dart": true,
    },
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "mobile(Prod)",
        "cwd": "${workspaceFolder:mobile}",
        "request": "launch",
        "type": "dart",
        "program": "lib/main.dart",
        "args": ["--dart-define-from-file=.env.production.local"],
      },
      {
        "name": "mobile(Local)",
        "cwd": "${workspaceFolder:mobile}",
        "request": "launch",
        "type": "dart",
        "program": "lib/main.dart",
        "args": ["--dart-define-from-file=.env.local"],
      },
      {
        "name": "(release) mobile",
        "cwd": "${workspaceFolder:mobile}",
        "request": "launch",
        "type": "dart",
        "program": "lib/main.dart",
        "args": ["--release", "--dart-define-from-file=.env.production.local"],
      },
    ],
  },
  "extensions": {
    "recommendations": [
      "dart-code.dart-code",
      "dart-code.flutter",
      "oxc.oxc-vscode",
      "bradlc.vscode-tailwindcss",
      "streetsidesoftware.code-spell-checker",
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Flutter: build_runner watch",
        "type": "shell",
        "command": "dart run build_runner watch -d",
        "options": {
          "cwd": "${workspaceFolder:mobile}",
        },
        "problemMatcher": [],
        "group": "build",
        "isBackground": true,
      },
      {
        "label": "Flutter: clean",
        "type": "shell",
        "command": "flutter clean && flutter pub get",
        "options": {
          "cwd": "${workspaceFolder:mobile}",
        },
      },
      {
        "label": "Flutter: Build .ipa",
        "type": "shell",
        "command": "flutter clean && flutter pub get && flutter build ipa --dart-define-from-file=.env.local",
        "options": {
          "cwd": "${workspaceFolder:mobile}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Web: Dev Server",
        "type": "shell",
        "command": "pnpm dev",
        "options": {
          "cwd": "${workspaceFolder:web}",
        },
        "problemMatcher": [],
        "isBackground": true,
      },
      {
        "label": "Web: Build",
        "type": "shell",
        "command": "pnpm build",
        "options": {
          "cwd": "${workspaceFolder:web}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Supabase: Start",
        "type": "shell",
        "command": "pnpm supabase start",
        "options": {
          "cwd": "${workspaceFolder:web}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Supabase: Stop",
        "type": "shell",
        "command": "pnpm supabase stop",
        "options": {
          "cwd": "${workspaceFolder:web}",
        },
        "problemMatcher": [],
      },
    ],
  },
}
