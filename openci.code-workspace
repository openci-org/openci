{
  "folders": [
    {
      "name": "mobile",
      "path": "mobile",
    },
    {
      "name": "openci_worker_cli",
      "path": "cli/openci_worker_cli",
    },
    {
      "name": "openci_vm_cli",
      "path": "cli/openci_vm_cli",
    },
    {
      "name": "firebase-functions",
      "path": "firebase/functions",
    },
    {
      "name": "firebase",
      "path": "firebase",
    },
    {
      "name": "root",
      "path": ".",
    },
    {
      "name": "web",
      "path": "web",
    },
    {
      "name": "server",
      "path": "server",
    },
    {
      "name": "worker",
      "path": "worker",
    },
  ],
  "settings": {
    "npm.packageManager": "pnpm",
    "terminal.integrated.scrollback": 10000,
    "cSpell.words": [
      "bento",
      "bradlc",
      "cirruslabs",
      "cupertino",
      "dbaeumer",
      "esbenp",
      "firestore",
      "grayscale",
      "masahiro",
      "mocktail",
      "monokai",
      "oklch",
      "openci",
      "opennextjs",
      "oxfmt",
      "oxlint",
      "pubspec",
      "riverpod",
      "secretmanager",
      "shellenv",
      "Stylesheet",
      "Subcollection",
      "subcollections",
      "subheadline",
      "supabase",
      "tailwindplus",
      "turbopack",
      "unawaited",
      "uuidv",
    ],
    "editor.codeActionsOnSave": {
      "source.fixAll": "always",
      "source.organizeImports": "explicit",
    },
    "editor.formatOnSave": true,
    "[jsonc]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[json]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[javascript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[typescript]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[typescriptreact]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "[yaml]": {
      "editor.defaultFormatter": "oxc.oxc-vscode",
    },
    "files.associations": {
      "*.css": "tailwindcss",
    },
    "files.exclude": {
      "**/*.g.dart": true,
      "**/*.freezed.dart": true,
    },
  },
  "launch": {
    "version": "0.2.0",
    "configurations": [
      {
        "name": "mobile(Prod)",
        "cwd": "${workspaceFolder:mobile}",
        "request": "launch",
        "type": "dart",
        "program": "lib/main.dart",
        "args": ["--dart-define-from-file=.env.production.local"],
      },
      {
        "name": "mobile(Local)",
        "cwd": "${workspaceFolder:mobile}",
        "request": "launch",
        "type": "dart",
        "program": "lib/main.dart",
        "args": ["--dart-define-from-file=.env.local"],
      },
      {
        "name": "(release) mobile",
        "cwd": "${workspaceFolder:mobile}",
        "request": "launch",
        "type": "dart",
        "program": "lib/main.dart",
        "args": ["--release", "--dart-define-from-file=.env.production.local"],
      },
    ],
  },
  "extensions": {
    "recommendations": [
      "dart-code.dart-code",
      "dart-code.flutter",
      "oxc.oxc-vscode",
      "bradlc.vscode-tailwindcss",
      "streetsidesoftware.code-spell-checker",
    ],
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      // ── Flutter ──────────────────────────────────────
      {
        "label": "Flutter: build_runner watch",
        "type": "shell",
        "command": "dart run build_runner watch -d",
        "options": {
          "cwd": "${workspaceFolder:mobile}",
        },
        "problemMatcher": [],
        "group": "build",
        "isBackground": true,
      },
      {
        "label": "Flutter: clean",
        "type": "shell",
        "command": "flutter clean && flutter pub get",
        "options": {
          "cwd": "${workspaceFolder:mobile}",
        },
      },
      {
        "label": "Flutter: Build .ipa",
        "type": "shell",
        "command": "flutter clean && flutter pub get && flutter build ipa --dart-define-from-file=.env.local",
        "options": {
          "cwd": "${workspaceFolder:mobile}",
        },
        "problemMatcher": [],
      },
      // ── Web (Next.js) ─────────────────────────────────
      {
        "label": "Web: Dev Server",
        "type": "shell",
        "command": "pnpm dev",
        "options": {
          "cwd": "${workspaceFolder:web}",
        },
        "problemMatcher": [],
        "isBackground": true,
      },
      {
        "label": "Web: Build",
        "type": "shell",
        "command": "pnpm build",
        "options": {
          "cwd": "${workspaceFolder:web}",
        },
        "problemMatcher": [],
      },
      // ── Supabase ─────────────────────────────────────
      {
        "label": "Supabase: Start",
        "type": "shell",
        "command": "make sb-start",
        "options": {
          "cwd": "${workspaceFolder:server}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Supabase: Stop",
        "type": "shell",
        "command": "make sb-stop",
        "options": {
          "cwd": "${workspaceFolder:server}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Supabase: Reset (drop + migrate + seed)",
        "type": "shell",
        "command": "make sb-reset",
        "options": {
          "cwd": "${workspaceFolder:server}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Supabase: Status",
        "type": "shell",
        "command": "make sb-status",
        "options": {
          "cwd": "${workspaceFolder:server}",
        },
        "problemMatcher": [],
      },
      // ── Worker (TypeScript) ────────────────────────────
      {
        "label": "Worker: Dev Run",
        "type": "shell",
        "command": "pnpm tsx src/index.tsx",
        "options": {
          "cwd": "${workspaceFolder:worker}",
        },
        "problemMatcher": [],
        "isBackground": true,
      },
      {
        "label": "Worker: Production Run",
        "type": "shell",
        "command": "pnpm tsx src/index.tsx --prod",
        "options": {
          "cwd": "${workspaceFolder:worker}",
        },
        "problemMatcher": [],
        "isBackground": true,
      },
      // ── Server (Deploy) ────────────────────────────
      {
        "label": "Server: Deploy Production",
        "type": "shell",
        "command": "make vercel-deploy-prod",
        "options": {
          "cwd": "${workspaceFolder:server}",
        },
        "problemMatcher": [],
      },
      {
        "label": "Supabase: Push to Production",
        "type": "shell",
        "command": "pnpm supabase db push",
        "options": {
          "cwd": "${workspaceFolder:server}",
        },
        "problemMatcher": [],
      },
    ],
  },
}
