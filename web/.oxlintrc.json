{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "nextjs", "jsx-a11y", "import"],
  "rules": {
    "no-unused-vars": "warn",
    "nextjs/no-img-element": "off",
    "jsx-a11y/no-autofocus": "off"
  },
  "ignorePatterns": [".next/**", "node_modules/**", "out/**", ".vercel/**"]
}
