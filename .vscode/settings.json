{
    "cSpell.words": [
        "bento",
        "grayscale",
        "oklch",
        "openci",
        "opennextjs",
        "Stylesheet",
        "subheadline",
        "tailwindplus",
        "turbopack"
    ],
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "always"
    },
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "[jsonc]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode"
    },
    "files.associations": {
        "*.css": "tailwindcss"
    }
}