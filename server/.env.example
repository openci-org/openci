# Supabase - automatically injected by Vercel Marketplace integration
# Supabase - Vercel Marketplace 連携で自動注入される環境変数
# https://supabase.com/docs/guides/integrations/vercel-marketplace
#
# Mapping to values shown by `supabase start` / `supabase start` で表示される値との対応:
#   APIs > Project URL               -> NEXT_PUBLIC_SUPABASE_URL, SUPABASE_URL
#   Authentication Keys > Publishable -> NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY, SUPABASE_PUBLISHABLE_KEY
#   Authentication Keys > Secret      -> SUPABASE_SERVICE_ROLE_KEY
#   Database > URL                   -> POSTGRES_URL, POSTGRES_URL_NON_POOLING
#                                       (POSTGRES_PRISMA_URL adds ?pgbouncer=true / POSTGRES_PRISMA_URL は ?pgbouncer=true を付加)

# APIs > Project URL
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_URL=http://127.0.0.1:54321

# Authentication Keys > Publishable
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_ANON_KEY=

# Authentication Keys > Secret
SUPABASE_SERVICE_ROLE_KEY=

# Not shown by `supabase start`, check with `supabase status`
# `supabase start` では表示されない。`supabase status` で確認可能
SUPABASE_JWT_SECRET=

# Database > URL (postgresql://postgres:postgres@127.0.0.1:54322/postgres)
POSTGRES_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_PRISMA_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres?pgbouncer=true
POSTGRES_URL_NON_POOLING=postgresql://postgres:postgres@127.0.0.1:54322/postgres
POSTGRES_USER=postgres
POSTGRES_HOST=127.0.0.1
POSTGRES_PASSWORD=postgres
POSTGRES_DATABASE=postgres

# App URL — used to generate invitation email links
# アプリのURL — 招待メールのリンク生成に使用
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend — email delivery service
# Resend — メール配信サービス
# https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx
# Sender address for transactional emails / トランザクションメールの送信元アドレス
# Format: "Display Name <email>" e.g. "OpenCI <noreply@openci.io>"
RESEND_FROM_EMAIL=

# Sentry - automatically injected by Vercel Marketplace integration
# Sentry - Vercel Marketplace 連携で自動注入される環境変数
SENTRY_AUTH_TOKEN=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
