# PostgreSQL configurations
POSTGRES_DB=openci
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here

# App configuration
APP_ENV=production
# Set your Tailscale Funnel domain (e.g., https://your-vps.your-tailnet.ts.net)
OPENCI_DOMAIN=https://your-node-name.your-tailnet.ts.net

# GitHub Configurations
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here
GITHUB_APP_ID=your-github-app-id-here

# Worker Configurations
ALLOWED_WORKER_UIDS=comma-separated-allowed-worker-uids-here

INTERNAL_API_KEY=your-secure-internal-api-key-here

# Secret Encryption Configurations
SECRET_ENCRYPTION_KEY=your-secret-encryption-key-here
DATABASE_URL=postgres://postgres:your-secure-password-here@db:5432/openci

# Job Processor Configurations
OPENCI_RUNS_ON_PATTERN=macos-latest
LUME_BASE_VM_NAME=base-macos
TAILSCALE_API_KEY=your-tailscale-api-key-here
TAILSCALE_TAILNET=your-tailscale-tailnet-here
TAILSCALE_AUTHKEY=tskey-auth-your-key-here
OPENCI_EXCLUDE_IPS=comma-separated-ips-to-exclude-here

# Orchard Configurations
ORCHARD_API_URL=http://orchard-controller:6120
ORCHARD_SERVICE_ACCOUNT_NAME=bootstrap-admin
ORCHARD_SERVICE_ACCOUNT_TOKEN=your-orchard-bootstrap-token-here

# Sentry configurations
SENTRY_DSN=your-sentry-dsn-for-server-here
SENTRY_DSN_JOB_PROCESSOR=your-sentry-dsn-for-job-processor-here
