# PostgreSQL configurations
POSTGRES_DB=openci
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password-here

# S3 / SeaweedFS configurations
S3_ENDPOINT=http://localhost:18000
S3_ACCESS_KEY=your-access-key-here
S3_SECRET_KEY=your-secret-key-here

# App configuration
APP_ENV=development
OPENCI_DOMAIN=http://localhost

# GitHub Configurations
GITHUB_WEBHOOK_SECRET=your-github-webhook-secret-here
GITHUB_APP_ID=your-github-app-id-here

# Worker Configurations
ALLOWED_WORKER_UIDS=comma-separated-allowed-worker-uids-here

INTERNAL_API_KEY=your-secure-internal-api-key-here

# Secret Encryption Configurations
SECRET_ENCRYPTION_KEY=your-secret-encryption-key-here
DATABASE_URL=postgres://postgres:your-secure-password-here@db:5432/openci

# Job Processor Configurations
OPENCI_RUNS_ON_PATTERN=macos-latest
LUME_BASE_VM_NAME=base-macos
TAILSCALE_API_KEY=your-tailscale-api-key-here
TAILSCALE_TAILNET=your-tailscale-tailnet-here
