{
  "name": "openci-worker-cli",
  "version": "0.1.30",
  "description": "OpenCI Worker CLI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openci-org/openci.git",
    "directory": "apps/worker_cli_node"
  },
  "bin": {
    "openci_worker": "dist/index.cjs"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "dist/index.cjs",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "npm run clean && node scripts/build.mjs",
    "check": "tsc --noEmit",
    "dev": "tsx src/index.ts",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "lint": "vp lint",
    "lint:fix": "vp lint --fix",
    "pack:dry-run": "npm run check && npm run build && npm pack --dry-run",
    "test": "vitest run",
    "prepublishOnly": "npm run check && npm run build"
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^6.1.1",
    "@sentry/node": "^10.29.0",
    "firebase-admin": "^13.8.0",
    "google-auth-library": "^10.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.19",
    "vitest": "^4.1.5"
  },
  "engines": {
    "node": "22"
  },
  "packageManager": "npm@11.13.0"
}
