{
  "hosting": {
    "target": "website",
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "predeploy": ["cd \"$PROJECT_DIR\" && bash scripts/ci.sh"],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=0, must-revalidate"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "/en/",
        "type": 301
      },
      {
        "source": "/blog",
        "destination": "/ja/blog/",
        "type": 301
      },
      {
        "source": "/blog/:path*",
        "destination": "/ja/blog/:path/",
        "type": 301
      },
      {
        "source": "/docs",
        "destination": "/ja/docs/",
        "type": 301
      },
      {
        "source": "/docs/:path*",
        "destination": "/ja/docs/:path/",
        "type": 301
      }
    ]
  },
  "emulators": {
    "hosting": {
      "host": "127.0.0.1",
      "port": 62843
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
