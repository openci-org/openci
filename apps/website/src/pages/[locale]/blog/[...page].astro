---
import { getCollection, render } from "astro:content";
import BlogIndex from "../../../layouts/BlogIndex.astro";
import BlogArticle from "../../../layouts/BlogArticle.astro";
import type { Page } from "../../../lib/content";
export async function getStaticPaths() {
  const pages = await getCollection("pages");
  return pages.map((page) => ({
    params: {
      locale: page.id.split("/")[0],
      page: page.id.split("/").slice(2).join("/") || undefined,
    },
    props: { page, pages },
  }));
}
interface Props {
  page: Page;
  pages: Page[];
}
const { page, pages } = Astro.props;
const { Content, headings } = await render(page);
---

{page.data.layout === "blog-index" ? (
  <BlogIndex page={page} pages={pages} />
) : (
  <BlogArticle page={page} pages={pages} headings={headings}>
    <Content />
  </BlogArticle>
)}
