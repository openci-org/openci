---
import ProductLayout from "../../layouts/ProductLayout.astro";
import Pricing from "../../components/Pricing.astro";
import { locales, translator, type Locale } from "../../lib/i18n";
export const getStaticPaths = () =>
  locales.map((locale) => ({ params: { locale } }));
const locale = Astro.currentLocale as Locale;
const t = translator(locale);
---

<ProductLayout
  locale={locale}
  path="pricing/"
  title={t("料金 | OpenCI", "Pricing | OpenCI")}
  description={t(
    "OpenCI CloudはLinuxが1分0.1円、macOSが1分1円（税込）。ランナーごとの月額料金を試算できます。",
    "Estimate monthly runner costs at ¥0.1 per minute for Linux or 1 US cent per minute for macOS, tax included.",
  )}
>
  <Pricing locale={locale} />
</ProductLayout>
