---
import ProductLayout from "../../layouts/ProductLayout.astro";
import LandingContent from "../../components/LandingContent.astro";
import LandingSections from "../../components/LandingSections.astro";
import {
  locales,
  siteTitle,
  siteDescription,
  type Locale,
} from "../../lib/i18n";
export const getStaticPaths = () =>
  locales.map((locale) => ({ params: { locale } }));
const locale = Astro.currentLocale as Locale;
---

<ProductLayout
  locale={locale}
  title={siteTitle(locale)}
  description={siteDescription(locale)}
>
  <LandingContent locale={locale} />
  <LandingSections locale={locale} />
</ProductLayout>
