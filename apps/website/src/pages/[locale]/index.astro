---
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "../../layouts/BaseLayout.astro";
import LanguageSwitcher from "../../components/LanguageSwitcher.astro";
import LandingHeader from "../../components/LandingHeader.astro";
import LandingContent from "../../components/LandingContent.astro";
import LandingSections from "../../components/LandingSections.astro";
import LandingFooter from "../../components/LandingFooter.astro";
import {
  locales,
  translator,
  siteTitle,
  siteDescription,
  type Locale,
} from "../../lib/i18n";
export const getStaticPaths = () =>
  locales.map((locale) => ({ params: { locale } }));
const locale = Astro.currentLocale as Locale;
const t = translator(locale);
const translations = Object.fromEntries(
  locales.map((language) => [language, getRelativeLocaleUrl(language)]),
);
---

<BaseLayout
  locale={locale}
  title={siteTitle(locale)}
  description={siteDescription(locale)}
  path={getRelativeLocaleUrl(locale)}
  translations={translations}
>
  <LanguageSwitcher translations={translations} />
  <a class="skip-link" href="#main">
    <span>{t("本文へスキップ", "Skip to content")}</span>
  </a>
  <div class="hero-shell">
    <LandingHeader locale={locale} />
    <LandingContent locale={locale} />
  </div>
  <LandingSections locale={locale} />
  <LandingFooter locale={locale} />
</BaseLayout>
