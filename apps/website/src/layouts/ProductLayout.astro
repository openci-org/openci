---
import type { ComponentProps } from "astro/types";
import { getRelativeLocaleUrl } from "astro:i18n";
import BaseLayout from "./BaseLayout.astro";
import LandingHeader from "../components/LandingHeader.astro";
import LandingFooter from "../components/LandingFooter.astro";
import { locales, translator, type Locale } from "../lib/i18n";
import "../styles/landing.css";
interface Props extends Omit<
  ComponentProps<typeof BaseLayout>,
  "translations"
> {
  path?: string;
  translations?: Partial<Record<Locale, string>>;
}
const {
  locale,
  path = "",
  translations = Object.fromEntries(
    locales.map((lang) => [lang, getRelativeLocaleUrl(lang, path)]),
  ),
  ...metadata
} = Astro.props;
const t = translator(locale);
---

<BaseLayout locale={locale} translations={translations} {...metadata}>
  <a class="skip-link" href="#main">
    {t("本文へスキップ", "Skip to content")}
  </a>
  <LandingHeader locale={locale} translations={translations} />
  <main id="main">
    <slot />
  </main>
  <LandingFooter locale={locale} />
  <div
    class="display-controls"
    role="group"
    aria-label={t("表示設定", "Display preferences")}
    hidden
  >
    <button
      type="button"
      data-motion
      aria-label={t("アニメーションを一時停止", "Pause animation")}
      aria-pressed="false"
    >
      <span aria-hidden="true">Ⅱ</span>
    </button>
    <button
      type="button"
      data-theme
      aria-label={t("ダークモード", "Dark mode")}
      aria-pressed="false"
    >
      <span aria-hidden="true">☾</span>
    </button>
  </div>
  <script>
    import "../scripts/landing";
  </script>
</BaseLayout>
