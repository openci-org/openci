---
import { getRelativeLocaleUrl } from "astro:i18n";
import type { MarkdownHeading } from "astro";
import ProductLayout from "./ProductLayout.astro";
import PostMeta from "../components/PostMeta.astro";
import PostCover from "../components/PostCover.astro";
import Toc from "../components/Toc.astro";
import Icon from "../components/Icon.astro";
import { translator, type Locale } from "../lib/i18n";
import {
  availableTranslations,
  blogImagePath,
  blogPosts,
  pagePath,
  plainTitle,
  type Page,
} from "../lib/content";
import "../styles/content.css";
import "../styles/blog.css";
interface Props {
  page: Page;
  pages: Page[];
  headings: MarkdownHeading[];
}
const { page, pages, headings } = Astro.props;
const locale = Astro.currentLocale as Locale,
  t = translator(locale);
const posts = blogPosts(pages, locale),
  index = posts.findIndex((post) => post.id === page.id);
const next = posts.length > 1 ? posts[(index + 1) % posts.length] : undefined;
const title = plainTitle(page.data.title);
const blog = getRelativeLocaleUrl(locale, "blog/");
---

<ProductLayout
  locale={locale}
  title={title + " — OpenCI Blog"}
  description={page.data.description}
  translations={availableTranslations(page, pages)}
  image={blogImagePath(page)}
  imageAlt={title}
  imageType="image/png"
  type="article"
  section={page.data.category}
>
  <article class="container blog-article">
    <header class="article-masthead">
      <div>
        <a class="back-to-blog" href={blog}>
          ← {t("ブログ一覧", "All articles")}
        </a>
        <PostMeta post={page} />
        <h1>{page.data.title}</h1>
        <p class="article-lead">{page.data.description}</p>
        {page.data.author && <p class="article-byline">{page.data.author}</p>}
      </div>
      <PostCover post={page} featured />
    </header>
    <div class="article-layout">
      {headings.length > 0 && (
        <aside class="article-sidebar">
          <details open>
            <summary>{t("この記事の目次", "On this page")}</summary>
            <nav aria-label={t("記事の目次", "Article contents")}>
              <Toc headings={headings} />
            </nav>
          </details>
        </aside>
      )}
      <div class="article-body">
        <div class="content">
          <slot />
        </div>
      </div>
    </div>
  </article>
  {next && (
    <section
      class="container article-next"
      aria-label={t("次の記事", "Next article")}
    >
      <span class="blog-label">{t("次の記事", "Read next")}</span>
      <a href={pagePath(next)}>
        <h2>{plainTitle(next.data.title)}</h2>
        <Icon name="arrow" marketing />
      </a>
      <a class="back-to-blog" href={blog}>
        {t("ブログ一覧へ", "Back to the blog")}
      </a>
    </section>
  )}
</ProductLayout>
