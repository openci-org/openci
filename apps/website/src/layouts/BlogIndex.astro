---
import ProductLayout from "./ProductLayout.astro";
import PostMeta from "../components/PostMeta.astro";
import PostCover from "../components/PostCover.astro";
import Icon from "../components/Icon.astro";
import { translator, type Locale } from "../lib/i18n";
import {
  availableTranslations,
  blogPosts,
  pagePath,
  type Page,
} from "../lib/content";
import "../styles/blog.css";
interface Props {
  page: Page;
  pages: Page[];
}
const { page, pages } = Astro.props;
const locale = Astro.currentLocale as Locale,
  t = translator(locale);
const posts = blogPosts(pages, locale),
  featured = posts[0];
const categories = [...new Set(posts.map((p) => p.data.category!))];
---

<ProductLayout
  locale={locale}
  title={page.data.title}
  description={page.data.description}
  translations={availableTranslations(page, pages)}
>
  <header class="container blog-heading">
    <h1>
      OpenCI <em>Blog.</em>
    </h1>
    <p>{page.data.description}</p>
  </header>
  {featured && (
    <section class="container" aria-labelledby="latest-heading">
      <h2 id="latest-heading" class="blog-label">
        {t("最新の記事", "Latest article")}
      </h2>
      <a class="featured-post" href={pagePath(featured)}>
        <PostCover post={featured} featured />
        <div class="featured-copy">
          <PostMeta post={featured} />
          <h3>{featured.data.title}</h3>
          <p>{featured.data.description}</p>
          <span class="text-link">
            {t("記事を読む", "Read article")} <Icon name="external" marketing />
          </span>
        </div>
      </a>
    </section>
  )}
  <section class="container blog-list" aria-labelledby="articles-heading">
    <div class="list-heading">
      <h2 id="articles-heading" class="section-title">
        {t("すべての記事", "All articles")}
      </h2>
      <span class="article-count" data-article-count aria-live="polite">
        {t(
          posts.length + "件",
          posts.length + (posts.length === 1 ? " article" : " articles"),
        )}
      </span>
    </div>
    <div
      class="article-filters"
      role="group"
      aria-label={t("記事をカテゴリで絞り込む", "Filter articles by category")}
    >
      <button
        type="button"
        data-category-filter="all"
        aria-pressed="true"
        aria-controls="article-grid"
      >
        {t("すべて", "All")}
      </button>
      {categories.map((category) => (
        <button
          type="button"
          data-category-filter={category}
          aria-pressed="false"
          aria-controls="article-grid"
        >
          {category}
        </button>
      ))}
    </div>
    <div id="article-grid" class="article-grid">
      {posts.map((post) => (
        <article class="post-card" data-article-category={post.data.category}>
          <a class="post-card-link" href={pagePath(post)}>
            <PostCover post={post} />
            <PostMeta post={post} />
            <h3>{post.data.title}</h3>
            <p>{post.data.description}</p>
          </a>
        </article>
      ))}
    </div>
  </section>
</ProductLayout>
