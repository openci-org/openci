---
import { getRelativeLocaleUrl } from "astro:i18n";
import Icon from "./Icon.astro";
import LanguageSwitcher from "./LanguageSwitcher.astro";
import { translator, type Locale } from "../lib/i18n";
interface Props {
  locale: Locale;
  translations: Partial<Record<Locale, string>>;
}
const { locale, translations } = Astro.props;
const t = translator(locale);
const home = getRelativeLocaleUrl(locale);
const links = [
  [home + "#apis", "Flutter API"],
  [home + "#quickstart", t("始め方", "Quickstart")],
  [getRelativeLocaleUrl(locale, "pricing/"), t("料金", "Pricing")],
  [home + "#guides", t("ガイド", "Guides")],
  [getRelativeLocaleUrl(locale, "blog/"), t("ブログ", "Blog")],
];
---

<header class="product-nav">
  <div class="container nav-bar">
    <a class="wordmark" href={home}>
      <img src="/favicon.png" alt="" width="26" height="26" />
      OpenCI
    </a>
    <nav
      class="desktop-links"
      aria-label={t("メインナビゲーション", "Main navigation")}
    >
      {links.map(([href, label]) => (
        <a
          href={href}
          aria-current={Astro.url.pathname === href ? "page" : undefined}
        >
          {label}
        </a>
      ))}
    </nav>
    <div class="nav-actions">
      <LanguageSwitcher translations={translations} />
      <a
        class="action primary dashboard-link"
        href="https://dashboard.openci.org/"
      >
        {t("ダッシュボード", "Dashboard")} <Icon name="external" marketing />
      </a>
      <details class="mobile-nav">
        <summary aria-label={t("メニュー", "Menu")}>
          <Icon name="menu" />
        </summary>
        <nav aria-label={t("モバイルナビゲーション", "Mobile navigation")}>
          {links.map(([href, label]) => (
            <a
              href={href}
              aria-current={Astro.url.pathname === href ? "page" : undefined}
            >
              {label}
            </a>
          ))}
          <a href="https://dashboard.openci.org/">
            {t("ダッシュボード", "Dashboard")} ↗
          </a>
        </nav>
      </details>
    </div>
  </div>
</header>
