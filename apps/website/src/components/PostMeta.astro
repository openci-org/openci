---
import { pageLocale, type Page } from "../lib/content";
interface Props {
  post: Page;
}
const { post } = Astro.props;
const readTime =
  pageLocale(post) === "ja"
    ? post.data.readTime?.replace(/^(\d+) min read$/, "約$1分")
    : post.data.readTime;
---

<div class="post-meta">
  <span class="post-category">{post.data.category}</span>
  <time datetime={post.data.date}>{post.data.date?.replaceAll("-", ".")}</time>
  {readTime && <span>{readTime}</span>}
</div>
