---
import { getRelativeLocaleUrl } from "astro:i18n";
import Icon from "./Icon.astro";
import { translator, type Locale } from "../lib/i18n";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
---

<header class="site-header wrap blog-header">
  <a class="brand" href={getRelativeLocaleUrl(locale)}>
    <span>GenuineCI</span>
  </a>
  <nav
    class="blog-nav"
    aria-label={t("メインナビゲーション", "Main navigation")}
  >
    <a class="blog-product-link" href={getRelativeLocaleUrl(locale)}>
      <span>{t("プロダクト", "Product")}</span>
    </a>
    <a href={getRelativeLocaleUrl(locale, "docs/")}>
      <span>Docs</span>
    </a>
    <a
      class="blog-workflow-link"
      href={getRelativeLocaleUrl(locale) + "#workflow"}
    >
      <span>{t("ワークフロー", "Workflows")}</span>
    </a>
    <a
      class="nav-current"
      href={getRelativeLocaleUrl(locale, "blog/")}
      aria-current="page"
    >
      {t("ブログ", "Blog")}
    </a>
  </nav>
  <a
    class="button button-small button-dark"
    href={getRelativeLocaleUrl(locale) + "#get-started"}
  >
    <span>{t("はじめる", "Get started")}</span>
    <Icon name="arrow" marketing />
  </a>
</header>
