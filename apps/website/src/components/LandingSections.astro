---
import { getRelativeLocaleUrl } from "astro:i18n";
import { Code } from "astro:components";
import Icon from "./Icon.astro";
import { translator, type Locale } from "../lib/i18n";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
const docs = getRelativeLocaleUrl(locale, "docs/");
const examples = [
  {
    id: "flutter",
    label: t("解析・テスト", "Analyze & test"),
    title: t("変更のたびに品質を確かめる。", "Check every change."),
    body: t(
      "静的解析とユニットテストを同じワークフローに並べます。プルリクエストで同じチェックを実行できます。",
      "Run static analysis and unit tests together, then use the same checks on pull requests.",
    ),
    code: "await ci.flutter.staticAnalysis();\nawait ci.flutter.unitTests();",
    guide: "flutter/",
  },
  {
    id: "android",
    label: "Android",
    title: t(
      "テスト用とストア用をビルドする。",
      "Build for testers and the store.",
    ),
    body: t(
      "ステージング用のAPKと、Google Playに提出するApp Bundleを生成します。",
      "Build a staging APK and an Android App Bundle for Google Play.",
    ),
    code: "await ci.flutter.buildApk(\n  flavor: 'staging',\n);\nawait ci.flutter.buildAab();",
    guide: "flutter/",
  },
  {
    id: "testflight",
    label: "TestFlight",
    title: t(
      "署名済みのIPAをTestFlightへ。",
      "Send a signed IPA to TestFlight.",
    ),
    body: t(
      "署名済みIPAのパスとApp Store Connectのキーを渡してアップロードします。キーはチームのシークレットで管理できます。",
      "Upload a signed IPA using its path and your App Store Connect API key. Keep the key in your team’s secrets.",
    ),
    code: "await ci.flutter.deployIpaToTestFlight(\n  ipaPath: ipaPath,\n  ascKeys: ascKeys,\n);",
    guide: "secrets/",
  },
];
const steps = [
  {
    title: t("SDKを追加", "Add the SDK"),
    text: t(
      "Flutterプロジェクトのルートで、ワークフロー用のSDKを開発依存に追加します。",
      "Add the workflow SDK as a development dependency at the root of your Flutter project.",
    ),
    command: "flutter pub add --dev openci_workflow",
    label: t("SDKを見る", "View the SDK"),
    href: "https://pub.dev/packages/openci_workflow",
  },
  {
    title: t("ワークフローを作成", "Write a workflow"),
    text: t(
      "リポジトリ直下のopenciディレクトリにDartファイルを置き、テスト内容と実行するブランチを指定します。",
      "Create a Dart file in the openci directory. Define the tests and the branches that should run them.",
    ),
    command: "openci/flutter_ci.dart",
    label: t("ファイルの記入例", "See an example"),
    href: docs + "quickstart/",
  },
  {
    title: t("ローカルからCIへ", "Go from local to CI"),
    text: t(
      "手元で実行を確認したら、GitHub Appとリポジトリを連携します。指定したイベントで同じ処理が動きます。",
      "Run the workflow locally, then connect your repository to the GitHub App to run it on the events you choose.",
    ),
    command: "dart run openci/flutter_ci.dart",
    label: t("トリガーの設定", "Configure triggers"),
    href: docs + "triggers/",
  },
];
const guides = [
  {
    image: "guide-start",
    path: "quickstart/",
    title: t("最初のワークフローを動かす", "Run your first workflow"),
    text: t(
      "SDKを追加し、手元でテストを実行するまで。",
      "Install the SDK and run a test on your own machine.",
    ),
  },
  {
    image: "guide-signing",
    path: "secrets/",
    title: t("署名キーをチームで管理する", "Manage signing keys"),
    text: t(
      "配布に使うキーを登録し、ワークフローから参照する方法。",
      "Store distribution credentials and use them in a workflow.",
    ),
  },
  {
    image: "guide-hosting",
    path: "self-hosting/",
    title: t("自分のMacでCIを運用する", "Run CI on your own Mac"),
    text: t(
      "Apple SiliconのMacとFirebaseを使うセルフホストの構成。",
      "Set up a self-hosted runner with an Apple Silicon Mac and Firebase.",
    ),
  },
];
---

<section id="workflow" class="tinted api-section">
  <div id="apis" class="container api-grid">
    <div>
      <span class="eyeline">Flutter API</span>
      <h2 class="section-title">
        {t("テストも配布も、", "Test and ship")}
        <br />
        {t("いつもの", "with ")}
        <em>Dart</em>
        {t("で。", ".")}
      </h2>
      <p class="prose">
        {t(
          "ワークフローもDartで書くので、エディタの補完が使えます。変更はアプリと同じプルリクエストでレビューできます。",
          "Use editor autocomplete to write your workflows in Dart. Review changes alongside the app in the same pull request.",
        )}
      </p>
      <a class="text-link" href={docs + "flutter/"}>
        {t("Flutter API一覧", "Flutter API reference")}{" "}
        <Icon name="external" marketing />
      </a>
    </div>
    <div class="api-panel">
      <div
        class="tabs"
        role="tablist"
        aria-label={t("Dart APIの実行例", "Dart API examples")}
      >
        {examples.map((ex, i) => (
          <button
            type="button"
            role="tab"
            data-workflow
            id={"tab-" + ex.id}
            aria-controls={"workflow-" + ex.id}
            aria-selected={i === 0}
            tabindex={i === 0 ? 0 : -1}
          >
            {ex.label}
          </button>
        ))}
      </div>
      {examples.map((ex, i) => (
        <div
          class="example"
          role="tabpanel"
          id={"workflow-" + ex.id}
          aria-labelledby={"tab-" + ex.id}
          hidden={i > 0}
          tabindex="0"
        >
          <div class="code-block">
            <div class="file-name">{"{ }"}　openci/flutter_ci.dart</div>
            <button
              type="button"
              data-blog-copy
              aria-label={t("コードをコピー", "Copy code")}
            >
              <Icon name="copy" />
            </button>
            <Code code={ex.code} lang="dart" theme="css-variables" />
          </div>
          <h3>{ex.title}</h3>
          <p>{ex.body}</p>
          <a class="text-link" href={docs + ex.guide}>
            {t("ガイドを読む", "Read the guide")}{" "}
            <Icon name="external" marketing />
          </a>
        </div>
      ))}
    </div>
  </div>
</section>
<section class="container section-pad" id="get-started">
  <div id="quickstart" class="section-head">
    <div>
      <span class="eyeline">{t("クイックスタート", "Quickstart")}</span>
      <h2 class="section-title">
        {t("手元のFlutterアプリで", "Start with your own")}
        <br />
        {t("はじめる。", "Flutter app.")}
      </h2>
    </div>
    <p>
      {t(
        "解析とテストを手元で確かめてから、プルリクエストに接続します。",
        "Try your checks locally, then connect them to pull requests.",
      )}
    </p>
  </div>
  <ol class="steps">
    {steps.map((s, i) => (
      <li>
        <div>
          <small>{String(i + 1).padStart(2, "0")}</small>
          <h3>{s.title}</h3>
        </div>
        <p>{s.text}</p>
        <div>
          <code>{s.command}</code>
          <a class="text-link" href={s.href}>
            {s.label} <Icon name="external" marketing />
          </a>
        </div>
      </li>
    ))}
  </ol>
</section>
<section class="tinted section-pad" id="guides">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyeline">{t("ドキュメント", "Documentation")}</span>
        <h2 class="section-title">{t("開発者ガイド", "Developer guides")}</h2>
      </div>
      <p>
        {t(
          "手元でのテストから、チームでの運用まで。",
          "From local tests to running CI for your team.",
        )}
      </p>
    </div>
    <div class="guides">
      {guides.map((g) => (
        <a href={docs + g.path}>
          <div class="cover">
            <img
              src={"/images/landing/" + g.image + ".webp"}
              alt=""
              width="720"
              height="546"
              loading="lazy"
            />
            <span>↗</span>
          </div>
          <h3>{g.title}</h3>
          <p>{g.text}</p>
          <span class="text-link">{t("ガイドを読む", "Read the guide")} ↗</span>
        </a>
      ))}
    </div>
  </div>
</section>
<section class="closing-banner">
  <div class="container">
    <h2 class="section-title">
      {t("最初のFlutterテストを", "Run your first Flutter test")}
      <br />
      {t("OpenCIで動かす。", "with OpenCI.")}
    </h2>
    <div class="actions">
      <a class="action" href="https://dashboard.openci.org/">
        {t("ダッシュボードを開く", "Open dashboard")} ↗
      </a>
      <a class="action light-outline" href={docs + "quickstart/"}>
        {t("導入ガイド", "Quickstart guide")}
      </a>
    </div>
  </div>
</section>
