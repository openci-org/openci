---
import { getRelativeLocaleUrl } from "astro:i18n";
import Icon from "./Icon.astro";
import PriceEstimate from "./PriceEstimate.astro";
import { translator, type Locale } from "../lib/i18n";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale),
  pricing = getRelativeLocaleUrl(locale, "pricing/");
const features = [
  {
    icon: "cpu",
    title: t("Apple SiliconのMac", "Apple Silicon Macs"),
    text: t(
      "FlutterアプリのテストからiOSビルドまで、OpenCIが用意したmacOSランナーで実行できます。",
      "Run Flutter tests and build iOS apps on macOS runners managed by OpenCI.",
    ),
    link: t("Cloudの料金を見る", "See cloud pricing"),
    href: pricing,
  },
  {
    icon: "code",
    title: t("Dartで書けるAPI", "APIs written for Dart"),
    text: t(
      "解析、テスト、ストアへのアップロード。アプリと同じDartで、必要な処理を組み合わせます。",
      "Combine analysis, tests and store uploads in the same language you use for your app.",
    ),
    link: t("APIの例を見る", "Explore the APIs"),
    href: "#apis",
  },
  {
    icon: "person",
    title: t("Flutter開発歴10年", "10 years building with Flutter"),
    text: t(
      "Flutterアプリを10年作ってきた開発者が、日々のテストやリリースに使う道具としてOpenCIを開発しています。",
      "OpenCI is built by a developer with ten years of Flutter experience, for the tests and releases that come with shipping real apps.",
    ),
    link: t("最初のテストを動かす", "Run your first test"),
    href: "#quickstart",
  },
];
---

<section class="container intro" aria-labelledby="intro-heading">
  <a class="claim" href={pricing + "#comparison"}>
    <span>CLOUD</span>
    {t("世界最安", "World’s lowest-priced")}
    <sup>*</sup>
    {t("のmacOSランナー", " macOS runners")}
  </a>
  <h1 id="intro-heading">
    {locale === "ja" ? (
      <>
        <em>Flutter</em>専用のCIを、
      </>
    ) : (
      <>
        CI for <em>Flutter,</em>
      </>
    )}
    <br />
    <strong>{t("1分1円で。", "¥1 per minute.")}</strong>
  </h1>
  <p>
    {t(
      "Apple SiliconのMacで、ビルドとテストを自動化。",
      "Automate builds and tests on Apple Silicon Macs.",
    )}
    <br />
    {t(
      "TestFlightへの配布も、DartのAPIで書けます。",
      "Ship to TestFlight with APIs you can call from Dart.",
    )}
  </p>
  <div class="actions">
    <a class="action" href="#estimate">
      {t("料金を試算する", "Estimate costs")}
    </a>
    <a class="action primary" href="https://dashboard.openci.org/">
      {t("OpenCIをはじめる", "Start with OpenCI")}{" "}
      <Icon name="external" marketing />
    </a>
  </div>
</section>
<section
  class="container"
  id="pricing"
  aria-label={t(
    "OpenCI Cloudの料金と特徴",
    "OpenCI Cloud pricing and features",
  )}
>
  <div class="lake" id="estimate">
    <img
      class="lake-image"
      src="/images/landing/blanca-lake.webp"
      width="660"
      height="371"
      alt=""
      fetchpriority="high"
    />
    <canvas class="lake-motion" aria-hidden="true"></canvas>
    <PriceEstimate locale={locale} />
  </div>
  <div class="features" id="features">
    {features.map((f) => (
      <article>
        <Icon name={f.icon} />
        <h2>{f.title}</h2>
        <p>{f.text}</p>
        <a class="text-link" href={f.href}>
          {f.link} <Icon name="external" marketing />
        </a>
      </article>
    ))}
  </div>
</section>
