---
import { getRelativeLocaleUrl } from "astro:i18n";
import PriceEstimate from "./PriceEstimate.astro";
import Icon from "./Icon.astro";
import { translator, type Locale } from "../lib/i18n";
import { formatRuntimeEstimate, usdCentsPerMinute } from "../lib/pricing";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
const comparisonJpyPerUsd = 150;
const comparisonUsdPerMinute =
  locale === "ja" ? 1 / comparisonJpyPerUsd : usdCentsPerMinute / 100;
const githubMacosUsdPerMinute = 0.062;
const savingsPercent = Math.round(
  (1 - comparisonUsdPerMinute / githubMacosUsdPerMinute) * 100,
);
---

<header class="container pricing-intro">
  <span class="eyeline">OpenCI Cloud / {t("料金", "Pricing")}</span>
  <h1>
    {t("Macの実行時間、", "Mac runtime,")}
    <br />
    <strong>{t("1分1円。", "1 cent per minute.")}</strong>
  </h1>
  <p>
    {t(
      "Flutterアプリのビルド、テスト、配布に使った時間を",
      "Add up your team's Flutter builds, tests and releases.",
    )}
    <br />
    {t(
      "チームで合計して、月ごとに計算します。",
      "Pay for the time you used each month.",
    )}
  </p>
</header>
<div class="container" id="pricing">
  <section class="plans" aria-label={t("ランナーを選ぶ", "Runner options")}>
    <article class="cloud-plan">
      <span class="card-label">
        <Icon name="cpu" marketing /> OpenCI Cloud
      </span>
      <h2>
        <strong>{t("¥1", `${usdCentsPerMinute}¢`)}</strong>
        <small>{t(" / 分（税込）", " / min, tax included")}</small>
      </h2>
      <p>
        {t(
          "OpenCIが管理するApple SiliconのMacで実行。CI用のMacを用意する手間を省けます。",
          "Use Apple Silicon Macs managed by OpenCI. Your team can start without buying CI hardware.",
        )}
      </p>
      <ul class="benefits">
        <li>
          <Icon name="check" marketing />
          {t(
            "環境の準備が終わってから課金",
            "Billing starts after machine setup",
          )}
        </li>
        <li>
          <Icon name="check" marketing />
          {t("チーム単位の同時実行数制限なし", "No per-team concurrency limit")}
        </li>
      </ul>
      <a class="action primary" href="https://dashboard.openci.org/">
        {t("ダッシュボードを開く", "Open dashboard")} ↗
      </a>
    </article>
    <article>
      <span class="card-label">
        <Icon name="server" /> Self-hosted
      </span>
      <h2>{t("自分のMacで実行", "Bring your own Mac")}</h2>
      <p>
        {t(
          "社内のApple SiliconのMacをランナーに。マシンとインフラはチームで用意・運用します。",
          "Use an Apple Silicon Mac as your runner. Your team provides and operates the machine and infrastructure.",
        )}
      </p>
      <ul class="benefits">
        <li>
          <Icon name="check" marketing />
          {t("Cloudの実行料金は発生しません", "No OpenCI Cloud runtime fees")}
        </li>
        <li>
          <Icon name="check" marketing />
          {t(
            "機材やFirebaseなどの費用はチーム負担",
            "Bring your own hardware and Firebase project",
          )}
        </li>
      </ul>
      <a
        class="action"
        href={getRelativeLocaleUrl(locale, "docs/self-hosting/")}
      >
        {t("セルフホストの手順", "Self-hosting guide")} ↗
      </a>
    </article>
  </section>
  <section id="estimate" class="usage">
    <div>
      <span class="eyeline">{t("利用例", "Usage example")}</span>
      <h2 class="section-title">
        {t("10分のビルドを", "One ten-minute build,")}
        <br />
        {t("平日に1回なら。", "every weekday.")}
      </h2>
      <p class="prose">
        {t(
          "月20回で合計200分、実行料金は200円です。ジョブごとの端数は、月の合計で一度だけ切り上げます。",
          `Twenty builds add up to 200 minutes. Budget ${formatRuntimeEstimate(200, "en")} for the month. Partial minutes are rounded up once on the monthly total.`,
        )}
      </p>
    </div>
    <PriceEstimate locale={locale} editable />
  </section>
  <section class="comparison" id="comparison">
    <h2>{t("「世界最安」の比較条件", "How we compare macOS prices")}</h2>
    <p class="pricing-savings">
      {t(
        `1ドル＝${comparisonJpyPerUsd}円の換算例では、GitHub ActionsのmacOSより、`,
        "At 1 cent per minute, that’s about ",
      )}
      <span class="pricing-savings-amount">
        {t(`分単価が約${savingsPercent}%安い。`, `${savingsPercent}% less`)}
      </span>
      {t("", " per macOS minute than GitHub Actions.")}
    </p>
    <table class="pricing-comparison">
      <caption>
        {t(
          `macOSの有料実行・1分あたり（1ドル＝${comparisonJpyPerUsd}円の換算例）`,
          "Paid macOS runtime per minute (US cents)",
        )}
      </caption>
      <tbody>
        <tr>
          <th scope="row">OpenCI Cloud</th>
          <td>
            {t(
              `US$${comparisonUsdPerMinute.toFixed(4)}`,
              `${usdCentsPerMinute}¢`,
            )}
          </td>
        </tr>
        <tr>
          <th scope="row">GitHub Actions macOS</th>
          <td>
            {t(
              `US$${githubMacosUsdPerMinute.toFixed(3)}`,
              `${(githubMacosUsdPerMinute * 100).toFixed(1)}¢`,
            )}
          </td>
        </tr>
      </tbody>
    </table>
    <p class="pricing-comparison-note">
      {t(
        "GitHub-hosted標準macOSランナーの有料分単価と比較。無料利用・割引を除く。2026-11-08確認。",
        "Compared with paid per-minute rates for standard GitHub-hosted macOS runners. Free usage and discounts excluded. Checked 2026-11-08.",
      )}{" "}
      <a href="https://docs.github.com/en/billing/reference/actions-runner-pricing">
        {t("GitHub公式料金", "GitHub pricing")}
      </a>
    </p>
    <p class="pricing-comparison-note">
      {t(
        "※「世界最安」は、当社が公開料金を確認した下記3サービスとのmacOS分単価比較によるものです（2026-11-08時点、1ドル＝150円の換算例）。無料利用・割引・定額契約を除きます。",
        '*"World\'s lowest-priced" compares OpenCI with the published macOS rates of the three providers below as of 2026-11-08. Free usage, discounts and fixed-price plans are excluded.',
      )}{" "}
      <a href="https://docs.github.com/en/billing/reference/actions-runner-pricing">
        GitHub Actions
      </a>
      {" / "}
      <a href="https://codemagic.io/pricing/">Codemagic</a>
      {" / "}
      <a href="https://namespace.so/pricing">Namespace</a>
    </p>
  </section>
  <section class="faq section-pad" id="faq">
    <div>
      <span class="eyeline">FAQ</span>
      <h2 class="section-title">{t("よくある質問", "Common questions")}</h2>
    </div>
    <div>
      {[
        [
          t("どの時間が料金の対象ですか？", "How is runtime measured?"),
          t(
            "VM準備完了後の実行時間をチームごとに月単位で合計し、最後に1分単位に切り上げます。100分20秒なら101円（税込）です。",
            "We add up team runtime after VM preparation and round up once at month-end. A total of 100 minutes and 20 seconds counts as 101 billable minutes.",
          ),
        ],
        [
          t(
            "複数人や並列のジョブでも使えますか？",
            "How do team and parallel jobs work?",
          ),
          t(
            "チーム全員の実行時間を合算します。同時実行数のチーム上限はありません。ジョブの開始時刻はワーカーの空き状況によります。",
            "Runtime is summed across your team, including parallel jobs. There is no per-team concurrency limit. Start times depend on runner availability.",
          ),
        ],
        [
          t(
            "米ドルでの支払いや請求設定は？",
            "How do USD invoices and billing settings work?",
          ),
          t(
            "月の円建て合計を月締め時に記録した為替レートで換算します。チームのダッシュボードの「設定 → 課金を管理」から支払い設定を確認できます。",
            "We calculate actual charges at ¥1 per minute, tax included. For USD invoices, we convert the monthly total at the exchange rate recorded when the billing month closes. Choose your team in the dashboard and open Settings → Manage billing.",
          ),
        ],
        [
          t(
            "iOSの署名や配布には何が必要ですか？",
            "What do I need for iOS distribution?",
          ),
          t(
            "署名済みのIPAとApp Store ConnectのキーでTestFlightにアップロードできます。キーはチームのシークレットで管理できます。",
            "Provide a signed IPA and an App Store Connect API key to upload to TestFlight. Store the key in your team’s secrets.",
          ),
        ],
        [
          t("自分のMacでも実行できますか？", "Can I use my own Mac?"),
          t(
            "手元でDartのワークフローを試せます。継続してCIを実行する場合はセルフホストを選べます。Macやクラウドのインフラ費用は利用者負担です。",
            "You can run the Dart workflow locally or self-host a persistent CI runner. Your team covers its Mac and infrastructure costs.",
          ),
        ],
      ].map(([q, a], i) => (
        <details name="billing-faq" open={i === 0}>
          <summary>
            {q}
            <span aria-hidden="true">+</span>
          </summary>
          <p>{a}</p>
        </details>
      ))}
    </div>
  </section>
</div>
