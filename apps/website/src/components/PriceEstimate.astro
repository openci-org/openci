---
import { translator, type Locale } from "../lib/i18n";
import {
  cloudRunners,
  formatMinuteRate,
  formatRuntimeEstimate,
} from "../lib/pricing";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
const initial = 200;
---

<div class="estimate-card" data-estimate>
  <header>
    <span class="card-label">
      <img src="/favicon.png" width="13" height="13" alt="" />
      OpenCI Cloud
    </span>
    <h2>{t("月の実行料金を試算", "Estimate your monthly cost")}</h2>
  </header>
  <div class="estimate-controls">
    <label for="minutes">{t("月の実行時間", "Monthly runtime")}</label>
    <input
      type="number"
      id="minutes"
      value={initial}
      min="0"
      step="any"
      inputmode="decimal"
    />
    <span>{t("分", "min")}</span>
  </div>
  <div class="estimate-results">
    {cloudRunners.map((runner) => (
      <div class="total">
        <small id={`rate-${runner}`}>
          {runner} · {formatMinuteRate(locale, runner)} / {t("分", "min")}
        </small>
        <output
          for="minutes"
          aria-labelledby={`rate-${runner}`}
          data-runner={runner}
        >
          {formatRuntimeEstimate(initial, locale, runner)}
        </output>
      </div>
    ))}
  </div>
  <p class="calculator-help">
    {t(
      "同じ実行時間での税込の月額目安です。月の合計を1分単位で切り上げます。",
      "Each estimate includes tax and uses the same monthly runtime, rounded up to the next minute.",
    )}
  </p>
</div>
