---
import Icon from "./Icon.astro";
import { translator, type Locale } from "../lib/i18n";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
---

<dialog id="docs-search" class="d-search-dialog" aria-labelledby="search-label">
  <div class="d-search-input-row">
    <Icon name="search" />
    <label id="search-label" class="d-sr-only" for="docs-query">
      {t("ドキュメントを検索", "Search documentation")}
    </label>
    <input
      id="docs-query"
      type="search"
      placeholder={t("キーワードで検索…", "Search by keyword…")}
      autocomplete="off"
    />
    <button
      class="d-search-close"
      type="button"
      data-search-close=""
      aria-label={t("検索を閉じる", "Close search")}
    >
      Esc
    </button>
  </div>
  <p id="docs-search-status" class="d-search-status" aria-live="polite"></p>
  <div id="docs-results" class="d-search-results"></div>
  <div class="d-search-footer">
    {t(
      "↑ ↓ 選択　↵ ページを開く　esc 閉じる",
      "↑ ↓ Select　↵ Open page　esc Close",
    )}
  </div>
</dialog>
