---
import type { Page } from "../lib/content";
import { plainTitle } from "../lib/content";
import Icon from "./Icon.astro";
interface Props {
  post: Page;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
---

<div
  class:list={["post-cover", "cover-release", { "cover-featured": featured }]}
  aria-hidden="true"
>
  <div class="cover-topline">
    <span>GenuineCI</span>
    <span>{post.data.date?.replaceAll("-", ".")}</span>
  </div>
  <div class="cover-message">
    <span>{post.data.coverTitle ?? plainTitle(post.data.title)}</span>
    <span>is here.</span>
  </div>
  <div class="cover-bottomline">
    <span>{post.data.coverLabel ?? post.data.category}</span>
    <Icon name="arrow" marketing />
  </div>
</div>
