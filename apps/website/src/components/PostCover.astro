---
import type { Page } from "../lib/content";
interface Props {
  post: Page;
  featured?: boolean;
}
const { post, featured = false } = Astro.props;
---

<div class="post-cover" aria-hidden="true">
  <img
    src={post.data.coverImage ?? "/images/landing/blanca-lake.webp"}
    alt=""
    loading={featured ? "eager" : "lazy"}
    decoding="async"
  />
  {post.data.coverLabel && <small>{post.data.coverLabel}</small>}
  {post.data.coverTitle && <span>{post.data.coverTitle}</span>}
</div>
