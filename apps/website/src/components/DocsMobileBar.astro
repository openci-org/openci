---
import Icon from "./Icon.astro";
import { translator, type Locale } from "../lib/i18n";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = translator(locale);
---

<div class="d-mobile-bar">
  <button
    class="d-mobile-toggle"
    type="button"
    data-menu-open=""
    aria-label={t("ドキュメントメニューを開く", "Open documentation menu")}
  >
    <Icon name="menu" />
    <span>{t("メニュー", "Menu")}</span>
  </button>
  <span>GenuineCI Docs</span>
</div>
