    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.4",
    "@astrojs/starlight": "^0.42.7",
    "astro": "^7.4.2",
    "astro-og-canvas": "^0.13.2",
    "hast-util-to-text": "^4.0.2",
    "unist-util-visit": "^5.1.0"
  }
}
