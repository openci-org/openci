{
  "name": "stacked-pr-app",
  "version": "0.3.0",
  "private": true,
  "description": "A database-free GitHub App for stacked PRs on Firebase Functions.",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "build": "tsc",
    "gcp-build": "",
    "check": "vp lint --deny-warnings src test integration_test scripts && tsc --noEmit",
    "fmt": "vp fmt",
    "fmt:check": "vp fmt --check",
    "test": "npm run build && node --test --test-concurrency=1 test/*.test.mjs integration_test/*.test.mjs",
    "test:runtime": "node scripts/smoke-runtime.mjs"
  },
  "dependencies": {
    "@octokit/auth-app": "^8.3.1",
    "@octokit/request": "^10.0.16",
    "@octokit/webhooks": "^14.2.0",
    "firebase-admin": "^14.5.0",
    "firebase-functions": "^7.4.0",
    "undici": "^7.19.0"
  },
  "devDependencies": {
    "@google-cloud/functions-framework": "^5.0.5",
    "@types/node": "^22.20.4",
    "typescript": "^6.0.3",
    "vite-plus": "^1.4.0"
  },
  "engines": {
    "node": "22"
  }
}
