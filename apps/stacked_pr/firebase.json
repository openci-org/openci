{
  "functions": [
    {
      "source": ".",
      "codebase": "stacked-pr",
      "runtime": "nodejs22",
      "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"],
      "ignore": [
        "node_modules",
        "src",
        "test",
        "integration_test",
        "docs",
        "scripts",
        "*.log",
        ".env*",
        ".secret.local",
        "secrets",
        "data",
        "coverage",
        "vite.config.mts",
        ".git"
      ]
    }
  ],
  "emulators": {
    "functions": {
      "host": "127.0.0.1",
      "port": 5002
    }
  }
}
