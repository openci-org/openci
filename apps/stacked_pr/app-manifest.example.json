{
  "name": "Stacked PR",
  "description": "Manage dependent pull requests and restack after parent updates and squash merges.",
  "url": "https://github.com/openci-org/openci/tree/develop/apps/stacked_pr",
  "hook_attributes": {
    "url": "https://asia-northeast1-YOUR_PROJECT.cloudfunctions.net/stackedPrWebhook",
    "active": true
  },
  "public": false,
  "default_permissions": {
    "metadata": "read",
    "contents": "write",
    "pull_requests": "write",
    "checks": "write"
  },
  "default_events": ["pull_request", "push", "issue_comment", "check_run"]
}
