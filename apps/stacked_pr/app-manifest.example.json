{
  "name": "Stacked PR",
  "description": "Manage dependent pull requests and restack after parent updates and squash merges.",
  "url": "https://stacked-pr.example-tailnet.ts.net/healthz",
  "hook_attributes": { "url": "https://stacked-pr.example-tailnet.ts.net/webhooks", "active": true },
  "public": false,
  "default_permissions": {
    "metadata": "read",
    "contents": "write",
    "pull_requests": "write",
    "checks": "write"
  },
  "default_events": ["pull_request", "push", "issue_comment", "check_run"]
}
