# Firebase CLI parameters. Copy to .env.<project-id> in this directory.
# Replace the example values with your deployment settings.
GITHUB_APP_ID=123456
# Exact bot login for this App (GET /app slug + [bot]); omit to filter only in worker.
STACKED_PR_BOT_LOGIN=your-app-slug[bot]
GITHUB_URL=https://github.example.com
STACKED_PR_RUNTIME_SERVICE_ACCOUNT=stacked-pr-runtime@YOUR_PROJECT.iam.gserviceaccount.com
STACKED_PR_TASK_SERVICE_ACCOUNT=stacked-pr-tasks@YOUR_PROJECT.iam.gserviceaccount.com
# Existing Firestore Native database used only for short-lived execution locks.
STACKED_PR_LOCK_DATABASE=(default)
# Optional UTC timestamp: delay new tasks until old-server tokens have expired.
STACKED_PR_RESUME_AT=
ALLOWED_REPOSITORIES=example-org/example-repo
AUTO_RESTACK=true
