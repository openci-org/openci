# GHES instance origin. All instance-specific values belong here, not in source code.
GITHUB_URL=https://git.example.com
GITHUB_APP_ID=12345
GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret-at-least-32-characters

# Local Dart runs use this file; Compose overrides it with the mounted secret path.
GITHUB_PRIVATE_KEY_FILE=./secrets/github-app.pem
DATA_DIR=./data
PORT=3000
HOST=127.0.0.1

# true: propagate parent changes automatically; false: observe until /stack sync.
AUTO_RESTACK=true

# Optional additional restriction. Empty means all repositories selected in the App installation.
ALLOWED_REPOSITORIES=org/repository

# For a private certificate authority, mount the CA file and configure BOTH:
# GITHUB_CA_FILE=/run/secrets/corporate_ca
# GIT_SSL_CAINFO=/run/secrets/corporate_ca
